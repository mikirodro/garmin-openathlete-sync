GARMIN_EMAIL=
GARMIN_PASSWORD=
# Alternatively, a mounted secret file:
GARMIN_PASSWORD_FILE=
OPENATHLETE_BASE_URL=http://api:3000
OPENATHLETE_EMAIL=
OPENATHLETE_PASSWORD=
OPENATHLETE_PASSWORD_FILE=
# Starts immediately, then runs every 24 hours.
SYNC_INTERVAL_SECONDS=86400
# Page size: ALL pages in the lookback window are read.
GARMIN_ACTIVITY_LIMIT=100
GARMIN_ACTIVITY_LOOKBACK_DAYS=7
TZ=Europe/Madrid
DATA_DIR=/data
