# Default deny: the Dockerfile only needs these build inputs.
**
!Dockerfile
!.dockerignore
!requirements.txt
!requirements.lock
!app/
!app/**

# Exclude secrets and generated/personal data even inside app/.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.envrc
**/secrets
**/credentials
**/.garminconnect
**/.garth
**/oauth1_token.json
**/oauth2_token.json
**/tokens.json
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/data
**/your_data
**/datos
**/*.fit
**/*.fit.part
**/*.tcx
**/*.gpx
**/*.name.txt
**/*.zip
**/*.sqlite*
**/*.db
**/*.db-*
**/response.json
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.log
**/*.bak
**/*.backup
**/*.tmp
**/*~
